# Required
OPENROUTER_API_KEY=

# OpenRouter app attribution (optional; sent as HTTP-Referer / X-OpenRouter-Title / X-Title)
MEDSIM_OPENROUTER_HTTP_REFERER=
MEDSIM_OPENROUTER_APP_TITLE=medsim

# Contact address placed in the User-Agent sent to Europe PMC and LitSense (recommended)
MEDSIM_CONTACT_EMAIL=

# Models (per-stage overrides fall back to MEDSIM_DEFAULT_MODEL)
MEDSIM_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
# MEDSIM_RESOLVER_MODEL=
# MEDSIM_QUERY_BUILDER_MODEL=
# MEDSIM_SYNTHESIZER_MODEL=
# MEDSIM_SYNTHESIZER_TEMPERATURE=0.2

# Retrieval
# MEDSIM_ENABLED_SOURCES=["europe_pmc","litsense"]
# MEDSIM_MAX_DOCUMENTS=8
# MEDSIM_MAX_DOC_CHARS=1500
# MEDSIM_EUROPE_PMC__PAGE_SIZE=50
# Retrieval changes 1-4 are on by default; see README.md "Retrieval changes 1-6"
# MEDSIM_RANK_FOR_VALUES=true
# MEDSIM_MERGE_STRATEGY=global
# MEDSIM_POPULATION_FILTER=true
# MEDSIM_LADDER_VERSION=v2
# MEDSIM_FULLTEXT_EXCERPTS=true
# MEDSIM_LITSENSE__QUERY_STYLE=keywords
# MEDSIM_LLM_RERANK=false
# MEDSIM_EUROPE_PMC__OPEN_ACCESS_ONLY=false
# MEDSIM_LITSENSE__MODE=passages
# MEDSIM_CACHE_ENABLED=false
# MEDSIM_CACHE_DIR=.medsim_cache

# MEDSIM_LOG_LEVEL=WARNING
