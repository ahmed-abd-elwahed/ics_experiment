.env
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.medsim_cache/
*.egg-info/
dist/
build/
.DS_Store

# Experiment records: finished case runs are appended here while a run is in progress
*.partial.jsonl

# Benchmark workspaces (intermediate JSONL; published results live in environment/results/)
bench_runs/

# ICD-11 codes looked up by the evaluation (every code used is saved in <record>.eval.json)
.icd_cache/

# Records over GitHub's 100 MB limit are committed gzipped (<record>.json.gz)
records/strategies_272_8it.json
records/strategies_272_16it.json
# v2 repetitions: every record is committed gzipped (the 8- to 32-question ones are over 100 MB).
# Runs with failed case runs are committed as their _merged record; the raw record and the
# _rerun_ parts it was merged from stay local.
records/strategies_272_v2_rep*it.json
records/strategies_272_v2_rep*it_merged.json
records/strategies_272_v2_rep*it_rerun_*.json
