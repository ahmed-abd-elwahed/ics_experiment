{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webapp",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "webapp",
        "--no-browser"
      ],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--directory",
        "site"
      ],
      "port": 8790,
      "autoPort": true
    }
  ]
}